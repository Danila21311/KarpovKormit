PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/restobar

# Токен для входа в /admin.html. Если в токене есть # или пробелы — обязательно в кавычках:
# ADMIN_TOKEN="my-secret-token"
ADMIN_TOKEN=change-me-local

# Supabase pooler: приложение само добавит ?pgbouncer=true и отключит prepared statements.
# Если всё равно обрывы — в панели Supabase попробуй строку Direct (db.*.supabase.co:5432).

# --- iiko: режим работы ---
# true = без реальных запросов к API (безопасно для разработки)
IIKO_STUB_MODE=true

# Базовый URL Cloud API (RU). Не путать с IIKO_API_LOGIN.
IIKO_API_BASE=https://api-ru.iiko.services

# Ключ доступа из кабинета iiko (не URL и не хост)
IIKO_API_LOGIN=

# id организации iikoTransport / Cloud
IIKO_ORGANIZATION_ID=789c92b5-6f47-4a7b-b5d8-681565c2aa3d

# id группы терминалов (уточнить у интегратора или получить через API)
IIKO_TERMINAL_GROUP_ID=

# Тип заказа: доставка курьером ресторана
IIKO_ORDER_TYPE_DELIVERY=76067ea3-356f-eb93-9d14-1fa00d082c4e

# Тип заказа: самовывоз курьером СберМаркета (если понадобится на сайте)
IIKO_ORDER_TYPE_SBERMARKET_PICKUP=b6d69b6f-bfa4-4f38-987e-87493db6cd6b

# Тип оплаты
IIKO_PAYMENT_TYPE_ID=715b8433-be3c-460e-9950-d69d18e82ab6

# Внешнее меню
IIKO_EXTERNAL_MENU_ID=72703

# Ценовая категория
IIKO_PRICE_CATEGORY_ID=acf711c6-de02-4a7a-932c-3d832737e087

